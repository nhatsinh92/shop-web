# Internal base URLs used by server-side fetches (src/lib/api/server.ts).
# Defaults are the shop-api `make demo` ports.
CORE_INTERNAL_URL=http://localhost:8081
CART_INTERNAL_URL=http://localhost:8082

# Shared secret for the signed POST /hooks/revalidate webhook sent by shop-api
# (the sender must use the same value). Unset: the route answers 404.
REVALIDATE_SECRET=
