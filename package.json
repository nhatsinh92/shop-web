{
  "name": "shop-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 . && next typegen && tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "gen:api": "for s in core cart; do pnpm exec openapi-typescript node_modules/@shop/api-contract/dist/$s.yaml -o src/lib/api/generated/$s.ts && V=$(node -p \"require('@shop/api-contract/package.json').version\") && { printf '// GENERATED from @shop/api-contract %s (dist/%s.yaml) by `pnpm gen:api`. Do not edit.\\n' \"$V\" $s; cat src/lib/api/generated/$s.ts; } > src/lib/api/generated/$s.tmp && mv src/lib/api/generated/$s.tmp src/lib/api/generated/$s.ts; done"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.7",
    "@shop/api-contract": "https://github.com/nhatsinh92/shop-api/releases/download/contract-v1.5.0/shop-api-contract-1.5.0.tgz",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/eslint-plugin-query": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-boundaries": "^7.4.4",
    "fake-indexeddb": "6.2.8",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  }
}
